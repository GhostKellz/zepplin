---
import BaseLayout from '../layouts/BaseLayout.astro';

const cats = [
  { slug: 'all', label: 'All' },
  { slug: 'networking', label: 'Networking' },
  { slug: 'crypto', label: 'Crypto' },
  { slug: 'database', label: 'Database' },
  { slug: 'web', label: 'Web' },
  { slug: 'cli', label: 'CLI Tools' },
  { slug: 'graphics', label: 'Graphics' },
  { slug: 'parsing', label: 'Parsing' },
  { slug: 'testing', label: 'Testing' },
];
---
<BaseLayout title="Browse Packages - Zepplin" active="browse">
  <div
    class="browse-page"
    x-data="{
      category: 'all',
      packages: [],
      loading: true,
      error: '',
      init() {
        const params = new URLSearchParams(window.location.search);
        this.category = params.get('category') || 'all';
        this.load();
      },
      select(cat) {
        this.category = cat;
        const url = cat === 'all' ? '/packages' : `/packages?category=${cat}`;
        history.pushState(null, '', url);
        this.load();
      },
      async load() {
        this.loading = true; this.error = ''; this.packages = [];
        try {
          let url = '/api/v1/packages?limit=50';
          if (this.category && this.category !== 'all') url += `&category=${encodeURIComponent(this.category)}`;
          const res = await fetch(url);
          const data = await res.json();
          this.packages = data.packages || data || [];
        } catch (e) {
          this.error = 'Failed to load packages. Please try again.';
        } finally {
          this.loading = false;
        }
      },
    }"
  >
    <div class="browse-header">
      <h1>Browse Packages</h1>
      <div class="categories">
        {cats.map((c) => (
          <a
            href={c.slug === 'all' ? '/packages' : `/packages?category=${c.slug}`}
            class="category-btn"
            :class={`{ active: category === '${c.slug}' }`}
            @click.prevent={`select('${c.slug}')`}
          >{c.label}</a>
        ))}
      </div>
    </div>

    <div class="loading" x-show="loading">Loading packages...</div>
    <div class="empty-state" x-show="!loading && !error && packages.length === 0">No packages found</div>
    <div class="empty-state" x-show="error" x-text="error"></div>
    <div class="package-grid" x-show="!loading && packages.length > 0">
      <template x-for="pkg in packages" :key="pkg.name || pkg.full_name">
        <div class="package-card">
          <h3>
            <a
              :href="`/packages/${pkg.name || pkg.full_name || (pkg.owner + '/' + pkg.repo)}`"
              x-text="pkg.name || pkg.full_name || (pkg.owner + '/' + pkg.repo)"
            ></a>
          </h3>
          <p class="package-description" x-text="pkg.description || 'No description'"></p>
          <div class="package-meta">
            <span class="package-version" x-text="pkg.version || pkg.latest_version || 'v0.0.0'"></span>
            <span><span x-text="pkg.downloads || 0"></span> downloads</span>
            <template x-if="pkg.stars"><span><span x-text="pkg.stars"></span> stars</span></template>
          </div>
        </div>
      </template>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .browse-page { max-width: 1200px; margin: 2rem auto; padding: 0 1rem; }
  .browse-header { margin-bottom: 2rem; }
  .browse-header h1 { color: var(--text-primary, #fff); margin: 0 0 1rem 0; }
  .browse-page .categories {
    display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2rem;
  }
  .category-btn {
    padding: 0.5rem 1rem; border-radius: 20px;
    border: 1px solid var(--border-color, #333); background: transparent;
    color: var(--text-primary, #fff); cursor: pointer; transition: all 0.2s;
    text-decoration: none;
  }
  .category-btn:hover, .category-btn.active {
    background: var(--accent-color, #ffd60a); color: #000;
    border-color: var(--accent-color, #ffd60a);
  }
  .browse-page .package-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;
  }
  .browse-page .package-card {
    background: var(--card-bg, #1a1a2e); border-radius: 12px; padding: 1.5rem;
    border: 1px solid var(--border-color, #333); transition: border-color 0.2s, transform 0.2s;
  }
  .browse-page .package-card:hover {
    border-color: var(--accent-color, #ffd60a); transform: translateY(-2px);
  }
  .browse-page .package-card h3 { margin: 0 0 0.5rem 0; }
  .browse-page .package-card h3 a { color: var(--accent-color, #ffd60a); text-decoration: none; }
  .browse-page .package-card h3 a:hover { text-decoration: underline; }
  .browse-page .package-description {
    color: var(--text-secondary, #888); margin: 0 0 1rem 0;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .browse-page .package-meta {
    display: flex; flex-wrap: wrap; gap: 1rem;
    color: var(--text-secondary, #888); font-size: 0.875rem;
  }
  .browse-page .package-version {
    background: rgba(255,214,10,0.1); color: var(--accent-color, #ffd60a);
    padding: 0.25rem 0.5rem; border-radius: 4px; font-family: monospace;
  }
  .browse-page .loading, .browse-page .empty-state {
    text-align: center; padding: 3rem; color: var(--text-secondary, #888);
  }
</style>

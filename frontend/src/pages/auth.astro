---
import AuthLayout from '../layouts/AuthLayout.astro';
---
<AuthLayout title="Sign In - Zepplin Registry">
  <div
    x-data="{
      mode: 'login',
      msg: { text: '', type: '', token: '', linkHref: '', linkLabel: '' },
      login: { username: '', password: '' },
      reg: { username: '', email: '', password: '' },
      providers: { github: false, microsoft: false, google: false },
      providersLoaded: false,
      get anyProvider() { return this.providers.github || this.providers.microsoft || this.providers.google; },
      init() {
        const params = new URLSearchParams(window.location.search);
        if (params.get('error')) {
          this.msg = { text: 'Authentication failed: ' + (params.get('error_description') || params.get('error')), type: 'error', token: '', linkHref: '', linkLabel: '' };
        } else if (localStorage.getItem('zepplin_token')) {
          const username = localStorage.getItem('zepplin_username') || localStorage.getItem('zepplin_display_name');
          if (username) this.msg = { text: `Already signed in as ${username}. `, type: 'success', token: '', linkHref: '/', linkLabel: 'Go to home' };
        }
        this.loadProviders();
      },
      async loadProviders() {
        try {
          const res = await fetch('/api/v1/auth/providers');
          if (res.ok) this.providers = await res.json();
        } catch (e) {
          // Leave all providers disabled on failure; email/password still works.
        } finally {
          this.providersLoaded = true;
        }
      },
      clearMsg() { this.msg = { text: '', type: '', token: '', linkHref: '', linkLabel: '' }; },
      showLogin() { this.mode = 'login'; this.clearMsg(); },
      showRegister() { this.mode = 'register'; this.clearMsg(); },
      async submitRegister() {
        try {
          const res = await fetch('/api/v1/auth/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(this.reg),
          });
          const data = await res.json();
          if (res.ok) {
            this.msg = { text: 'Account created! Your API token:', type: 'success', token: data.token, linkHref: '', linkLabel: '' };
            this.reg = { username: '', email: '', password: '' };
          } else {
            this.msg = { text: data.error || 'Registration failed', type: 'error', token: '', linkHref: '', linkLabel: '' };
          }
        } catch (e) {
          this.msg = { text: 'Network error: ' + e.message, type: 'error', token: '', linkHref: '', linkLabel: '' };
        }
      },
      async submitLogin() {
        try {
          const res = await fetch('/api/v1/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(this.login),
          });
          const data = await res.json();
          if (res.ok) {
            this.msg = { text: 'Welcome back! Redirecting...', type: 'success', token: '', linkHref: '', linkLabel: '' };
            localStorage.setItem('zepplin_token', data.token);
            localStorage.setItem('zepplin_username', data.username);
            setTimeout(() => window.location.href = '/', 1000);
          } else {
            this.msg = { text: data.error || 'Login failed', type: 'error', token: '', linkHref: '', linkLabel: '' };
          }
        } catch (e) {
          this.msg = { text: 'Network error: ' + e.message, type: 'error', token: '', linkHref: '', linkLabel: '' };
        }
      },
    }"
  >
    <div class="logo-section">
      <div class="logo-container">
        <img src="/assets/logo/login.png" alt="Zepplin" class="logo-img" />
      </div>
      <h1 class="app-title">Zepplin</h1>
      <p class="app-subtitle">Zig Package Registry</p>
    </div>

    <div class="login-container">
      <div>
        <template x-if="msg.text">
          <div class="message" :class="msg.type">
            <span x-text="msg.text"></span>
            <a x-show="msg.linkHref" :href="msg.linkHref" style="color: var(--mint-400);" x-text="msg.linkLabel"></a>
            <div class="token-display" x-show="msg.token" x-text="msg.token"></div>
          </div>
        </template>
      </div>

      <!-- Login Card -->
      <div class="login-card" x-show="mode === 'login'">
        <div class="welcome-text">
          <h2>Welcome back</h2>
          <p>Sign in to your account</p>
        </div>

        <div class="oauth-buttons" x-show="providersLoaded && anyProvider" x-cloak>
          <a href="/api/v1/auth/oauth/github/login" class="oauth-button github" x-show="providers.github">
            <svg class="oauth-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
            </svg>
            Sign in with GitHub
          </a>
          <a href="/api/v1/auth/oidc/microsoft/login" class="oauth-button microsoft" x-show="providers.microsoft">
            <svg class="oauth-icon" viewBox="0 0 23 23">
              <rect x="1" y="1" width="10" height="10" fill="#f25022"></rect>
              <rect x="12" y="1" width="10" height="10" fill="#7fba00"></rect>
              <rect x="1" y="12" width="10" height="10" fill="#00a4ef"></rect>
              <rect x="12" y="12" width="10" height="10" fill="#ffb900"></rect>
            </svg>
            Sign in with Microsoft
          </a>
          <a href="/api/v1/auth/oauth/google/login" class="oauth-button google" x-show="providers.google">
            <svg class="oauth-icon" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path>
              <path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.83z"></path>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.83C6.71 7.31 9.14 5.38 12 5.38z"></path>
            </svg>
            Sign in with Google
          </a>
        </div>

        <div class="divider" x-show="providersLoaded && anyProvider" x-cloak>or continue with email</div>

        <form @submit.prevent="submitLogin()">
          <div class="form-group">
            <label for="login-username">Username or Email</label>
            <input type="text" id="login-username" placeholder="Enter your username" x-model="login.username" required />
          </div>
          <div class="form-group">
            <label for="login-password">Password</label>
            <input type="password" id="login-password" placeholder="Enter your password" x-model="login.password" required />
          </div>
          <button type="submit" class="submit-button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
              <polyline points="10 17 15 12 10 7"></polyline>
              <line x1="15" y1="12" x2="3" y2="12"></line>
            </svg>
            Sign In
          </button>
        </form>

        <div class="register-link">
          New to Zepplin? <a href="#" @click.prevent="showRegister()">Create an account</a>
        </div>
      </div>

      <!-- Register Card -->
      <div class="login-card register-card" x-show="mode === 'register'" x-cloak>
        <a href="#" class="back-link" @click.prevent="showLogin()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          Back to sign in
        </a>

        <div class="welcome-text">
          <h2>Create account</h2>
          <p>Join the Zig package ecosystem</p>
        </div>

        <form @submit.prevent="submitRegister()">
          <div class="form-group">
            <label for="reg-username">Username</label>
            <input type="text" id="reg-username" placeholder="Choose a username" x-model="reg.username" required />
          </div>
          <div class="form-group">
            <label for="reg-email">Email</label>
            <input type="email" id="reg-email" placeholder="you@example.com" x-model="reg.email" required />
          </div>
          <div class="form-group">
            <label for="reg-password">Password</label>
            <input type="password" id="reg-password" placeholder="Create a password" x-model="reg.password" required />
          </div>
          <button type="submit" class="submit-button">Create Account</button>
        </form>

        <div class="register-link">
          Already have an account? <a href="#" @click.prevent="showLogin()">Sign in</a>
        </div>
      </div>
    </div>

    <div class="footer-section">
      <p class="footer-tagline">Blazing-fast package management for the Zig ecosystem</p>
      <div class="powered-by">
        <span class="powered-by-text">Powered by</span>
        <img src="/assets/logo/cktech/ck_hudu_icon_transparent_512.png" alt="CK Technology" class="cktech-logo" />
        <span class="powered-by-name">CK Technology</span>
      </div>
    </div>
  </div>
</AuthLayout>

<style is:global>
  .auth-body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--ocean-950);
    background-image:
      radial-gradient(ellipse at top left, rgba(0, 119, 182, 0.2) 0%, transparent 50%),
      radial-gradient(ellipse at bottom right, rgba(6, 255, 165, 0.08) 0%, transparent 50%),
      linear-gradient(180deg, #000814 0%, #001d3d 100%);
    color: var(--text-primary);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
</style>

<style>
  .logo-section { text-align: center; margin-bottom: 4rem; padding-top: 1rem; }
  .logo-container { display: flex; align-items: center; justify-content: center; margin-bottom: 2rem; }
  .logo-img { width: 220px; height: 220px; filter: drop-shadow(0 0 35px rgba(255, 214, 10, 0.6)); }
  .app-title {
    font-size: 3.75rem; font-weight: 800;
    background: linear-gradient(135deg, var(--lightning-500) 0%, var(--lightning-300) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    letter-spacing: -0.02em; margin-bottom: 1rem;
  }
  .app-subtitle { color: var(--text-muted); font-size: 1.35rem; letter-spacing: 0.15em; text-transform: uppercase; }
  .login-container { width: 100%; max-width: 440px; }
  .login-card {
    background: rgba(0, 29, 61, 0.9); backdrop-filter: blur(20px);
    border: 1px solid rgba(6, 255, 165, 0.15); border-radius: 20px; padding: 2.75rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), 0 0 40px rgba(0, 119, 182, 0.1);
  }
  .welcome-text { text-align: center; margin-bottom: 2.25rem; }
  .welcome-text h2 { font-size: 1.6rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem; }
  .welcome-text p { color: var(--text-muted); font-size: 0.95rem; }
  .oauth-buttons { display: flex; flex-direction: column; gap: 0.875rem; margin-bottom: 1.5rem; }
  .oauth-button {
    display: flex; align-items: center; justify-content: center; gap: 0.75rem;
    padding: 1rem 1.25rem; border-radius: 12px; text-decoration: none;
    font-size: 1rem; font-weight: 600; transition: all 0.2s ease; cursor: pointer;
  }
  .oauth-button.github {
    background: linear-gradient(135deg, var(--lightning-500) 0%, var(--lightning-400) 100%);
    border: none; color: var(--ocean-950); box-shadow: 0 4px 14px rgba(255, 214, 10, 0.25);
  }
  .oauth-button.github:hover {
    background: linear-gradient(135deg, var(--lightning-400) 0%, var(--lightning-300) 100%);
    transform: translateY(-2px); box-shadow: 0 8px 24px rgba(255, 214, 10, 0.35);
  }
  .oauth-button.github svg { fill: var(--ocean-950); }
  .oauth-button.microsoft {
    background: rgba(6, 255, 165, 0.05); border: 1px solid rgba(6, 255, 165, 0.25); color: var(--text-primary);
  }
  .oauth-button.microsoft:hover {
    background: rgba(6, 255, 165, 0.12); border-color: var(--mint-500);
    transform: translateY(-2px); box-shadow: 0 4px 16px rgba(6, 255, 165, 0.15);
  }
  .oauth-button.google {
    background: rgba(6, 255, 165, 0.05); border: 1px solid rgba(6, 255, 165, 0.25); color: var(--text-primary);
  }
  .oauth-button.google:hover {
    background: rgba(6, 255, 165, 0.12); border-color: var(--mint-500);
    transform: translateY(-2px); box-shadow: 0 4px 16px rgba(6, 255, 165, 0.15);
  }
  .oauth-icon { width: 22px; height: 22px; flex-shrink: 0; }
  .divider { display: flex; align-items: center; gap: 1rem; margin: 1.75rem 0; color: var(--text-muted); font-size: 0.85rem; }
  .divider::before, .divider::after {
    content: ''; flex: 1; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(6, 255, 165, 0.2), transparent);
  }
  .form-group { margin-bottom: 1.25rem; }
  .form-group label { display: block; color: var(--text-secondary); font-size: 0.9rem; font-weight: 500; margin-bottom: 0.5rem; }
  .form-group input {
    width: 100%; padding: 0.9rem 1rem; background: var(--ocean-950);
    border: 1px solid rgba(144, 224, 239, 0.2); border-radius: 10px;
    color: var(--text-primary); font-size: 1rem; transition: all 0.2s ease;
  }
  .form-group input::placeholder { color: var(--text-muted); opacity: 0.5; }
  .form-group input:focus { outline: none; border-color: var(--mint-500); box-shadow: 0 0 0 3px rgba(6, 255, 165, 0.15); }
  .submit-button {
    width: 100%; padding: 1rem;
    background: linear-gradient(135deg, var(--ocean-400) 0%, var(--ocean-300) 100%);
    color: var(--text-primary); border: none; border-radius: 10px; font-size: 1rem; font-weight: 600;
    cursor: pointer; transition: all 0.2s ease; display: flex; align-items: center; justify-content: center; gap: 0.5rem;
  }
  .submit-button:hover {
    background: linear-gradient(135deg, var(--ocean-300) 0%, var(--ocean-200) 100%);
    transform: translateY(-1px); box-shadow: 0 4px 12px rgba(0, 150, 199, 0.3);
  }
  .register-link {
    text-align: center; margin-top: 1.75rem; padding-top: 1.75rem;
    border-top: 1px solid rgba(6, 255, 165, 0.1); color: var(--text-muted); font-size: 0.95rem;
  }
  .register-link a { color: var(--mint-400); text-decoration: none; font-weight: 500; }
  .register-link a:hover { color: var(--mint-300); text-decoration: underline; }
  .message { padding: 1rem 1.25rem; border-radius: 10px; margin-bottom: 1.25rem; text-align: center; font-size: 0.95rem; }
  .message.success { background: rgba(6, 255, 165, 0.12); border: 1px solid rgba(6, 255, 165, 0.3); color: var(--mint-400); }
  .message.error { background: rgba(255, 0, 110, 0.12); border: 1px solid rgba(255, 0, 110, 0.3); color: #ff6b9d; }
  .token-display {
    background: var(--ocean-950); padding: 0.75rem; border-radius: 8px; word-break: break-all;
    font-family: 'SF Mono', Monaco, monospace; font-size: 0.75rem; margin-top: 0.75rem;
    color: var(--mint-400); border: 1px solid rgba(6, 255, 165, 0.15);
  }
  .back-link { display: flex; align-items: center; gap: 0.5rem; color: var(--text-muted); text-decoration: none; font-size: 0.9rem; margin-bottom: 1.25rem; }
  .back-link:hover { color: var(--mint-400); }
  .footer-section { text-align: center; margin-top: 2.5rem; }
  .footer-tagline { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.25rem; opacity: 0.8; }
  .powered-by {
    display: inline-flex; flex-direction: row; align-items: center; justify-content: center; gap: 0.75rem;
    padding: 0.85rem 1.75rem; background: rgba(72, 202, 228, 0.05);
    border: 1px solid rgba(72, 202, 228, 0.15); border-radius: 12px;
  }
  .powered-by-text { color: var(--text-secondary); font-size: 0.9rem; font-weight: 500; }
  .powered-by-name { color: var(--ocean-200); font-size: 0.95rem; font-weight: 700; }
  .cktech-logo { height: 42px; width: 42px; object-fit: contain; }
  @media (max-width: 480px) {
    .logo-section { margin-bottom: 2.5rem; }
    .logo-container { margin-bottom: 1.5rem; }
    .login-card { padding: 2rem; }
    .logo-img { width: 140px; height: 140px; }
    .app-title { font-size: 2.75rem; margin-bottom: 0.75rem; }
    .app-subtitle { font-size: 1rem; letter-spacing: 0.1em; }
  }
</style>

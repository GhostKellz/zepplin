---
import BareLayout from '../layouts/BareLayout.astro';
---
<BareLayout title="Publish Package - Zepplin Registry">
  <div
    class="publish-container"
    x-data="{
      loggedIn: false,
      username: '',
      token: '',
      form: { owner: '', repo: '', version: '', license: '', description: '', homepage: '' },
      file: null,
      fileName: '',
      fileSize: '',
      dragover: false,
      msg: { text: '', type: '' },
      submitting: false,
      init() {
        this.token = localStorage.getItem('zepplin_token') || '';
        this.username = localStorage.getItem('zepplin_username') || '';
        if (this.username) {
          this.loggedIn = true;
          this.form.owner = this.username;
        } else {
          this.showMsg('Please log in to publish packages', 'error');
          setTimeout(() => window.location.href = '/auth', 2000);
        }
      },
      logout() {
        localStorage.removeItem('zepplin_token');
        localStorage.removeItem('zepplin_username');
        window.location.href = '/auth';
      },
      showMsg(text, type) {
        this.msg = { text, type };
        if (type === 'success') setTimeout(() => { this.msg = { text: '', type: '' }; }, 5000);
      },
      handleFile(f) {
        if (!f) return;
        if (!f.name.endsWith('.tar.gz') && !f.name.endsWith('.tgz')) { this.showMsg('Please select a .tar.gz file', 'error'); return; }
        if (f.size > 50 * 1024 * 1024) { this.showMsg('File size must be less than 50MB', 'error'); return; }
        this.file = f; this.fileName = f.name; this.fileSize = this.formatSize(f.size);
      },
      onDrop(e) { this.dragover = false; const files = e.dataTransfer.files; if (files.length) this.handleFile(files[0]); },
      onPick(e) { if (e.target.files.length) this.handleFile(e.target.files[0]); },
      removeFile() { this.file = null; this.fileName = ''; this.fileSize = ''; this.$refs.fileInput.value = ''; },
      formatSize(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024; const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
      },
      autofillHomepage() {
        if (this.form.owner && this.form.repo && !this.form.homepage) {
          this.form.homepage = `https://github.com/${this.form.owner}/${this.form.repo}`;
        }
      },
      async submit() {
        if (!this.token) { this.showMsg('Authentication required', 'error'); return; }
        if (!this.file) { this.showMsg('Please select a package file', 'error'); return; }
        this.submitting = true;
        try {
          const fd = new FormData();
          fd.append('file', this.file);
          fd.append('tag_name', this.form.version);
          fd.append('body', this.form.description);
          fd.append('draft', 'false');
          fd.append('prerelease', 'false');
          const res = await fetch(`/api/v1/packages/${this.form.owner}/${this.form.repo}/releases`, {
            method: 'POST', headers: { Authorization: `Bearer ${this.token}` }, body: fd,
          });
          const data = await res.json();
          if (res.ok) {
            this.showMsg('Package published successfully!', 'success');
            setTimeout(() => window.location.href = `/packages/${this.form.owner}/${this.form.repo}`, 2000);
          } else {
            this.showMsg(data.error || 'Publishing failed', 'error');
          }
        } catch (e) {
          this.showMsg('Network error: ' + e.message, 'error');
        } finally {
          this.submitting = false;
        }
      },
    }"
  >
    <div class="publish-header">
      <a href="/" class="publish-logo">
        <img src="/assets/logo/Zepplin-logo.png" alt="Zepplin" />
        <span>Zepplin</span>
      </a>
      <div class="user-info">
        <span x-text="loggedIn ? username : 'Not logged in'"></span>
        <template x-if="loggedIn">
          <a href="#" class="button secondary" @click.prevent="logout()">Logout</a>
        </template>
        <template x-if="!loggedIn">
          <a href="/auth" class="button secondary">Login</a>
        </template>
      </div>
    </div>

    <div class="message" :class="msg.type" x-show="msg.text" x-text="msg.text" x-cloak></div>

    <div class="form-card">
      <h1>Publish Package</h1>
      <p class="subtitle">Share your Zig package with the community</p>

      <form @submit.prevent="submit()">
        <div class="form-row">
          <div class="form-group">
            <label for="owner">Owner <span class="required">*</span></label>
            <input type="text" id="owner" x-model="form.owner" @blur="autofillHomepage()" required />
          </div>
          <div class="form-group">
            <label for="repo">Package Name <span class="required">*</span></label>
            <input type="text" id="repo" x-model="form.repo" @blur="autofillHomepage()" required />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="version">Version <span class="required">*</span></label>
            <input type="text" id="version" placeholder="1.0.0" x-model="form.version" required />
          </div>
          <div class="form-group">
            <label for="license">License</label>
            <select id="license" x-model="form.license">
              <option value="">Select license</option>
              <option value="MIT">MIT</option>
              <option value="Apache-2.0">Apache 2.0</option>
              <option value="BSD-3-Clause">BSD 3-Clause</option>
              <option value="GPL-3.0">GPL 3.0</option>
              <option value="ISC">ISC</option>
              <option value="Unlicense">Unlicense</option>
            </select>
          </div>
        </div>

        <div class="form-group full-width">
          <label for="description">Description</label>
          <textarea id="description" placeholder="Brief description of your package" x-model="form.description"></textarea>
        </div>

        <div class="form-group full-width">
          <label for="homepage">Homepage URL</label>
          <input type="url" id="homepage" placeholder="https://github.com/user/repo" x-model="form.homepage" />
        </div>

        <div class="form-group full-width">
          <label>Package File <span class="required">*</span></label>
          <input type="file" x-ref="fileInput" @change="onPick($event)" accept=".tar.gz,.tgz" style="display:none" />
          <div
            class="file-upload"
            :class="{ dragover }"
            x-show="!file"
            @click="$refs.fileInput.click()"
            @dragover.prevent="dragover = true"
            @dragleave.prevent="dragover = false"
            @drop.prevent="onDrop($event)"
          >
            <svg class="file-upload-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"></path>
            </svg>
            <div class="file-upload-text">Click to upload or drag and drop</div>
            <div class="file-upload-hint">TAR.GZ files only (Max 50MB)</div>
          </div>
          <div class="file-info" x-show="file" x-cloak>
            <div>
              <div class="file-name" x-text="fileName"></div>
              <div class="file-size" x-text="fileSize"></div>
            </div>
            <button type="button" class="remove-file" @click="removeFile()">✕</button>
          </div>
        </div>

        <div class="form-actions">
          <a href="/" class="button secondary">Cancel</a>
          <button type="submit" class="button primary" :disabled="submitting">
            <template x-if="submitting"><span class="loading-spinner"></span></template>
            <span x-text="submitting ? 'Publishing...' : 'Publish Package'"></span>
          </button>
        </div>
      </form>
    </div>
  </div>
</BareLayout>

<style is:global>
  body { background: var(--bg-primary); }
</style>

<style>
  .publish-container { max-width: 800px; margin: 0 auto; padding: 2rem; color: var(--text-secondary); }
  .publish-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 2rem; padding: 1rem 0; border-bottom: 1px solid var(--border-color);
  }
  .publish-logo {
    display: flex; align-items: center; gap: 0.5rem; font-size: 1.5rem; font-weight: bold;
    color: var(--lightning-500); text-decoration: none;
  }
  .publish-logo img { width: 36px; height: 36px; }
  .user-info { display: flex; align-items: center; gap: 1rem; color: var(--text-secondary); }
  .form-card {
    background: var(--bg-secondary); border: 1px solid var(--border-color);
    border-radius: 16px; padding: 2rem; margin-bottom: 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }
  h1 {
    background: linear-gradient(135deg, var(--lightning-500) 0%, var(--lightning-300) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    margin-bottom: 0.5rem;
  }
  .subtitle { color: var(--text-muted); margin-bottom: 2rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
  .form-group { margin-bottom: 1rem; }
  .form-group.full-width { grid-column: 1 / -1; }
  label { display: block; color: var(--text-secondary); margin-bottom: 0.5rem; font-weight: 500; }
  .required { color: var(--error, #ff006e); }
  input, textarea, select {
    width: 100%; padding: 0.75rem; background: var(--ocean-950);
    border: 1px solid rgba(144, 224, 239, 0.2); border-radius: 8px;
    color: var(--text-primary); font-size: 1rem; transition: all 0.2s ease;
  }
  input:focus, textarea:focus, select:focus {
    outline: none; border-color: var(--mint-500); box-shadow: 0 0 0 3px rgba(6, 255, 165, 0.15);
  }
  textarea { min-height: 100px; resize: vertical; }
  .file-upload {
    border: 2px dashed rgba(144, 224, 239, 0.25); border-radius: 12px; padding: 2rem;
    text-align: center; transition: all 0.2s ease; cursor: pointer; background: var(--ocean-950);
  }
  .file-upload:hover { border-color: var(--mint-500); background: rgba(6, 255, 165, 0.04); }
  .file-upload.dragover { border-color: var(--lightning-500); background: rgba(255, 214, 10, 0.06); }
  .file-upload-icon { width: 48px; height: 48px; margin: 0 auto 1rem; opacity: 0.6; color: var(--ocean-200); }
  .file-upload-text { color: var(--text-secondary); margin-bottom: 0.5rem; }
  .file-upload-hint { color: var(--text-muted); font-size: 0.9rem; }
  .file-info {
    background: rgba(0, 119, 182, 0.12); border: 1px solid rgba(144, 224, 239, 0.2);
    border-radius: 8px; padding: 1rem; display: flex; align-items: center; justify-content: space-between;
  }
  .file-name { font-weight: 500; color: var(--text-primary); }
  .file-size { color: var(--text-muted); font-size: 0.9rem; }
  .remove-file { background: none; border: none; color: var(--error, #ff006e); cursor: pointer; padding: 0.25rem; font-size: 1rem; }
  .button {
    padding: 0.75rem 1.5rem; border: none; border-radius: 10px; font-size: 1rem; font-weight: 600;
    cursor: pointer; transition: all 0.2s ease; text-decoration: none;
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
  }
  .button.primary {
    background: linear-gradient(135deg, var(--lightning-500) 0%, var(--lightning-400) 100%);
    color: var(--ocean-950); box-shadow: 0 4px 14px rgba(255, 214, 10, 0.25);
  }
  .button.primary:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(255, 214, 10, 0.35); }
  .button.secondary {
    background: rgba(6, 255, 165, 0.05); border: 1px solid rgba(6, 255, 165, 0.25); color: var(--text-primary);
  }
  .button.secondary:hover { background: rgba(6, 255, 165, 0.12); border-color: var(--mint-500); }
  .button:disabled { opacity: 0.6; cursor: not-allowed; }
  .form-actions {
    display: flex; gap: 1rem; justify-content: flex-end; margin-top: 2rem; padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }
  .message { padding: 1rem; border-radius: 10px; margin-bottom: 1rem; text-align: center; }
  .message.success { background: rgba(6, 255, 165, 0.12); border: 1px solid rgba(6, 255, 165, 0.3); color: var(--mint-400); }
  .message.error { background: rgba(255, 0, 110, 0.12); border: 1px solid rgba(255, 0, 110, 0.3); color: #ff6b9d; }
  .message.info { background: rgba(0, 119, 182, 0.15); border: 1px solid rgba(0, 119, 182, 0.3); color: var(--ocean-200); }
  .loading-spinner {
    border: 2px solid rgba(0, 8, 20, 0.3); border-top: 2px solid var(--ocean-950);
    border-radius: 50%; width: 16px; height: 16px; animation: spin 1s linear infinite; display: inline-block;
  }
  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  @media (max-width: 600px) { .form-row { grid-template-columns: 1fr; } }
</style>

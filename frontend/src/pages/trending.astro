---
import BaseLayout from '../layouts/BaseLayout.astro';

const periods = [
  { id: 'week', label: 'This Week' },
  { id: 'month', label: 'This Month' },
  { id: 'all', label: 'All Time' },
];
---
<BaseLayout title="Trending Packages - Zepplin" active="trending">
  <div
    class="trending-page"
    x-data="{
      period: 'week',
      packages: [],
      loading: true,
      init() { this.load(); },
      select(p) { this.period = p; this.load(); },
      async load() {
        this.loading = true; this.packages = [];
        try {
          let packages = [];
          try {
            const z = await fetch(`/api/zigistry/trending?period=${this.period}&limit=20`);
            if (z.ok) { const d = await z.json(); packages = d.packages || d || []; }
          } catch (e) {}
          if (packages.length === 0) {
            const l = await fetch('/api/v1/packages?featured=true&limit=20');
            if (l.ok) { const d = await l.json(); packages = d.packages || d || []; }
          }
          this.packages = packages;
        } catch (e) {
          this.packages = [];
        } finally {
          this.loading = false;
        }
      },
    }"
  >
    <div class="trending-header">
      <h1>Trending Packages</h1>
      <p>Most popular packages this week</p>
    </div>

    <div class="time-filters">
      {periods.map((p) => (
        <button
          class="time-filter"
          :class={`{ active: period === '${p.id}' }`}
          @click={`select('${p.id}')`}
        >{p.label}</button>
      ))}
    </div>

    <div class="loading" x-show="loading">Loading trending packages...</div>
    <div class="package-list" x-show="!loading && packages.length > 0">
      <template x-for="(pkg, index) in packages" :key="pkg.name || pkg.full_name || index">
        <div class="package-card">
          <div class="package-rank" x-text="`#${index + 1}`"></div>
          <div class="package-info">
            <h3>
              <a
                :href="`/packages/${pkg.name || pkg.full_name || (pkg.owner + '/' + pkg.repo)}`"
                x-text="pkg.name || pkg.full_name || (pkg.owner + '/' + pkg.repo)"
              ></a>
            </h3>
            <p class="package-description" x-text="pkg.description || 'No description'"></p>
            <div class="package-meta">
              <span class="package-version" x-text="pkg.version || pkg.latest_version || 'v0.0.0'"></span>
              <span><span x-text="pkg.downloads || 0"></span> downloads</span>
              <template x-if="pkg.stars"><span><span x-text="pkg.stars"></span> stars</span></template>
              <template x-if="pkg.trend_score">
                <span class="trending-badge" x-text="`+${pkg.trend_score}% this week`"></span>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="empty-state" x-show="!loading && packages.length === 0">
      <h2>No trending packages yet</h2>
      <p>Be the first to publish a package and start the trend!</p>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .trending-page { max-width: 1000px; margin: 2rem auto; padding: 0 1rem; }
  .trending-header { margin-bottom: 2rem; }
  .trending-header h1 { color: var(--text-primary, #fff); margin: 0; }
  .trending-header p { color: var(--text-secondary, #888); margin: 0.5rem 0 0 0; }
  .time-filters { display: flex; gap: 0.5rem; margin-bottom: 2rem; }
  .time-filter {
    padding: 0.5rem 1rem; border-radius: 6px;
    border: 1px solid var(--border-color, #333); background: transparent;
    color: var(--text-primary, #fff); cursor: pointer; transition: all 0.2s;
  }
  .time-filter:hover, .time-filter.active {
    background: var(--accent-color, #ffd60a); color: #000; border-color: var(--accent-color, #ffd60a);
  }
  .package-list { display: flex; flex-direction: column; gap: 1rem; }
  .trending-page .package-card {
    background: var(--card-bg, #1a1a2e); border-radius: 12px; padding: 1.5rem;
    border: 1px solid var(--border-color, #333);
    display: flex; align-items: flex-start; gap: 1.5rem; transition: border-color 0.2s;
  }
  .trending-page .package-card:hover { border-color: var(--accent-color, #ffd60a); }
  .package-rank { font-size: 1.5rem; font-weight: bold; color: var(--accent-color, #ffd60a); min-width: 40px; }
  .package-info { flex: 1; }
  .package-info h3 { margin: 0 0 0.5rem 0; }
  .package-info h3 a { color: var(--text-primary, #fff); text-decoration: none; }
  .package-info h3 a:hover { color: var(--accent-color, #ffd60a); }
  .trending-page .package-description { color: var(--text-secondary, #888); margin: 0 0 1rem 0; }
  .trending-page .package-meta {
    display: flex; flex-wrap: wrap; gap: 1rem; color: var(--text-secondary, #888); font-size: 0.875rem;
  }
  .trending-page .package-version {
    background: rgba(255,214,10,0.1); color: var(--accent-color, #ffd60a);
    padding: 0.25rem 0.5rem; border-radius: 4px; font-family: monospace;
  }
  .trending-badge { display: inline-flex; align-items: center; gap: 0.25rem; color: #10b981; font-weight: 500; }
  .trending-page .loading { text-align: center; padding: 3rem; color: var(--text-secondary, #888); }
  .trending-page .empty-state {
    text-align: center; padding: 3rem; background: var(--card-bg, #1a1a2e);
    border-radius: 12px; border: 1px solid var(--border-color, #333);
  }
  .trending-page .empty-state h2 { color: var(--text-primary, #fff); margin: 0 0 1rem 0; }
  .trending-page .empty-state p { color: var(--text-secondary, #888); margin: 0; }
</style>

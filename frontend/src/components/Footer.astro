---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-section">
        <h3>Zepplin</h3>
        <p>The lightning-fast Zig package registry</p>
        <div class="social-links">
          <a href="https://github.com/ghostkellz/zepplin" class="social-link">GitHub</a>
          <a href="https://discord.gg/zig" class="social-link">Discord</a>
          <a href="https://twitter.com/ziglang" class="social-link">Twitter</a>
        </div>
      </div>
      <div class="footer-section">
        <h4>Packages</h4>
        <ul>
          <li><a href="/packages">Browse All</a></li>
          <li><a href="/trending">Trending</a></li>
          <li><a href="/categories">Categories</a></li>
          <li><a href="/publish">Publish</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>Documentation</h4>
        <ul>
          <li><a href="/docs">Getting Started</a></li>
          <li><a href="/docs/api">API Reference</a></li>
          <li><a href="/docs/cli">CLI Usage</a></li>
          <li><a href="/docs/contribute">Contributing</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>Community</h4>
        <ul>
          <li><a href="/status">Status</a></li>
          <li><a href="/support">Support</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="https://github.com/ghostkellz/zepplin">GitHub</a></li>
        </ul>
      </div>
    </div>
    <div class="hosted-by">
      <span class="hosted-by-label">Hosted &amp; maintained by</span>
      <img src="/assets/logo/cktech/banner-best.png" alt="CK Technology" class="hosted-by-banner" />
    </div>
    <div class="footer-bottom">
      <p>&copy; {year} Zepplin Registry. Powered by Zig.</p>
    </div>
  </div>
</footer>

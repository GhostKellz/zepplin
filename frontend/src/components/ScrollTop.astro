---
// Floating scroll-to-top button. Appears after scrolling down; Alpine tracks
// scroll position and smooth-scrolls back to the top on click.
---
<button
  type="button"
  class="scroll-top"
  aria-label="Scroll to top"
  x-data="{ shown: false }"
  x-init="shown = window.scrollY > 400"
  x-on:scroll.window.debounce.100ms="shown = window.scrollY > 400"
  x-show="shown"
  x-cloak
  x-transition.opacity
  x-on:click="window.scrollTo({ top: 0, behavior: 'smooth' })"
>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</button>
